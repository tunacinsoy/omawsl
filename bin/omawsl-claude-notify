#!/usr/bin/env bash
# Claude Code hook behind `omawsl notifications`: a Windows popup and/or a
# sound when a Claude Code session inside Herdr is done or needs you.
#
# Why not Herdr's own alerts: Herdr reads "done" off the screen, so every
# turn that ends to wait - for a background subagent, shell, monitor or
# scheduled wakeup - counts as finished (herdrdev/herdr#5004, an open bug,
# and #1217, idle by design). Claude's Stop hook says whether anything is
# still running, so this alerts only when nothing is. If Herdr ever gets
# this right, go back to its alerts: have omawsl_herdr_setup_notifications
# call omawsl_claude_hooks_remove and stop forcing Herdr's alerts off.
#
#   omawsl-claude-notify stop|notify|ask   (hook JSON on stdin)
#
# Installed into ~/.claude/settings.json by omawsl_claude_hooks_install.
# Reads the saved choice on every run, so `omawsl notifications` only has
# to add or remove the hooks. Always exits 0 - a hook must never get in
# Claude's way.
set -uo pipefail

event="${1:-}"
input="$(cat)"
[[ "${HERDR_ENV:-}" == 1 ]] || exit 0
command -v jq &>/dev/null || exit 0
jq -e 'type == "object"' <<< "$input" >/dev/null 2>&1 || exit 0

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../install/lib.sh
source "$ROOT/install/lib.sh"
choice="$(omawsl_load_choice OMAWSL_HERDR_NOTIFICATIONS)"
case "$choice" in
  both|sound|popup) ;;
  *) exit 0 ;;
esac

# field <jq path> - one string from the hook JSON, empty when missing.
field() {
  jq -r "$1 // empty" <<< "$input" 2>/dev/null
}

# session_title - the session's /rename name, else Claude's own title for
# it, read from the transcript. Empty when neither exists.
session_title() {
  local transcript
  transcript="$(field .transcript_path)"
  [[ -f "$transcript" ]] || return 0
  grep -E '"(customTitle|aiTitle)"' "$transcript" 2>/dev/null |
    jq -rs '(map(.customTitle // empty) | last) // (map(.aiTitle // empty) | last) // empty' 2>/dev/null
}

# herdr_name - the agent's name as Herdr's sidebar shows it: the pane's
# note (Ctrl g p c), else its title. Empty outside a Herdr pane.
herdr_name() {
  [[ -n "$pane" ]] || return 0
  jq -r '[.label, .terminal_title_stripped] | map(select(. != null and . != "")) | first // empty' <<< "$pane" 2>/dev/null
}

# herdr_workspace - the name of the Herdr workspace the agent runs in.
# Empty outside a Herdr pane.
herdr_workspace() {
  local id
  id="$(jq -r '.workspace_id // empty' <<< "$pane" 2>/dev/null)"
  [[ -n "$id" ]] || return 0
  herdr workspace get "$id" 2>/dev/null | jq -r '.result.workspace.label // empty' 2>/dev/null
}

# pending_tool - name of the newest tool call in the transcript that has
# no result yet (what a permission prompt is about). Empty when unknown.
pending_tool() {
  local transcript
  transcript="$(field .transcript_path)"
  [[ -f "$transcript" ]] || return 0
  tail -n 400 "$transcript" | jq -Rrn '
    [inputs | fromjson? | .message.content? | arrays | .[] | objects] as $blocks
    | [$blocks[] | select(.type == "tool_result") | .tool_use_id] as $done
    | [$blocks[] | select(.type == "tool_use") | select(.id as $id | $done | index($id) | not)]
    | last | .name // empty' 2>/dev/null
}

case "$event" in
  stop)
    # A subagent finishing, or the main agent pausing while background
    # work runs, is not the user's turn yet.
    [[ -z "$(field .agent_id)" ]] || exit 0
    running="$(jq -r '((.background_tasks // []) | length) + ((.session_crons // []) | length)' <<< "$input" 2>/dev/null)"
    [[ "$running" == 0 ]] || exit 0
    kind=done
    ;;
  notify)
    case "$(field .notification_type)" in
      permission_prompt|agent_needs_input|worker_permission_prompt|elicitation_dialog|elicitation_url_dialog) ;;
      *) exit 0 ;;
    esac
    body="$(field .message)"
    # An open question also sends a plain "Claude needs your permission"
    # prompt a few seconds later - the ask hook already announced it, with
    # the question itself.
    [[ "$body" != *AskUserQuestion* ]] || exit 0
    [[ "$(pending_tool)" != AskUserQuestion ]] || exit 0
    kind=request
    ;;
  ask)
    kind=request
    body="$(field '.tool_input.questions[0].question')"
    ;;
  *) exit 0 ;;
esac

# Name the agent the way Herdr's sidebar does, so you know which one to go to.
pane=""
if [[ -n "${HERDR_PANE_ID:-}" ]]; then
  pane="$(herdr pane get "$HERDR_PANE_ID" 2>/dev/null | jq -c '.result.pane // empty' 2>/dev/null)"
fi
title="$(herdr_name)"
[[ -n "$title" ]] || title="$(session_title)"
title="${title:-Claude Code}"
if [[ "$kind" == done ]]; then
  body="$(herdr_workspace)"
  if [[ -z "$body" ]]; then
    body="$(field .cwd)"
    body="${body%/}"
    body="${body##*/}"
    body="${body:-Finished}"
  fi
  title+=" — done"
  sound_file="Windows Notify System Generic.wav"
else
  title+=" — needs you"
  sound_file="Windows Proximity Notification.wav"
fi
body="${body:0:200}"

if [[ "$choice" != sound ]]; then
  "${OMAWSL_NOTIFY_SEND:-$ROOT/bin/omawsl-notify-send}" -- "$title" "$body" >/dev/null 2>&1 || true
fi
if [[ "$choice" != popup ]]; then
  paplay "${OMAWSL_NOTIFY_SOUND_DIR:-/mnt/c/Windows/Media}/$sound_file" >/dev/null 2>&1 || true
fi
exit 0
