#!/usr/bin/env bash
# GitHub Copilot CLI hook behind `omawsl notifications`: the same sounds
# as bin/omawsl-claude-notify, for Copilot sessions in Herdr - for
# machines where Copilot is the only agent allowed.
#
#   omawsl-copilot-notify stop|notify   (hook JSON on stdin)
#
# stop runs on agentStop, which fires only when the main agent finishes a
# turn - subagents have their own subagentStop, never hooked, so a subagent
# finishing doesn't alert. Only a turn that ended normally alerts
# (stopReason end_turn, or none at all from an older Copilot), so a turn
# cut short with any other stopReason stays quiet. notify runs on every
# Copilot notification and alerts only for a permission prompt or a
# question. Unlike Claude's Stop, agentStop doesn't say whether a
# background shell is still running.
#
# Installed as ~/.copilot/hooks/omawsl.json by omawsl_copilot_hooks_install.
# Always exits 0 - a hook must never get in Copilot's way.
set -uo pipefail

event="${1:-}"
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=omawsl-agent-alert.sh
source "$ROOT/bin/omawsl-agent-alert.sh"
omawsl_agent_alert_start

case "$event" in
  stop)
    case "$(field .stopReason)" in
      end_turn|"") ;;
      *) exit 0 ;;
    esac
    kind=done
    ;;
  notify)
    case "$(field .notification_type)" in
      permission_prompt|elicitation_dialog) ;;
      *) exit 0 ;;
    esac
    kind=request
    ;;
  *) exit 0 ;;
esac

omawsl_agent_alert "$kind"
exit 0
