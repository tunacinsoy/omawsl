# omawsl bashrc - baseline dev environment configuration for WSL2 Ubuntu.

case $- in
    *i*) ;;
      *) return;;
esac

HISTCONTROL=ignoreboth
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend
shopt -s checkwinsize

# Neovim is the only one of omawsl's 8 optional editor/AI-tool choices that's
# a general-purpose terminal text editor suited to $EDITOR/$VISUAL (VS
# Code/Cursor are GUI apps, the rest are AI coding agents, not blocking
# terminal editors) - so there's no real "which one is preferred" choice to
# make here, just whether nvim was installed at all. Falls back to nano
# (confirmed part of Ubuntu's base install, not something omawsl installs
# itself) so $EDITOR always points at something that exists, matching the
# same `command -v X &>/dev/null` guard already used below for every other
# optional tool in this file.
if command -v nvim &>/dev/null; then
  export EDITOR=nvim
  export VISUAL=nvim
else
  export EDITOR=nano
  export VISUAL=nano
fi

# Only points at omawsl's own inputrc when the user (or a corp policy) has
# no ~/.inputrc of their own - corp-safe config editing policy (design spec
# docs/superpowers/specs/2026-07-28-corp-safe-config-editing-design.md).
# ${BASH_SOURCE[0]} here resolves to this file's own real path (baked in
# by a-shell.sh's source line), so this needs no separate path variable.
if [ -z "${INPUTRC:-}" ] && [ ! -f "$HOME/.inputrc" ]; then
  export INPUTRC="$(dirname "${BASH_SOURCE[0]}")/inputrc"
fi

if command -v eza &>/dev/null; then
  alias ls='eza -lh --group-directories-first --icons=auto'
  alias lsa='ls -a'
  alias ll='eza -la'
  alias lt='eza --tree --level=2 --long --icons --git'
  alias lta='lt -a'
  alias tree='eza --tree'
else
  alias ll='ls -la'
fi

# apt's `bat` package installs its binary as `batcat` (name collision with
# an unrelated pre-existing Debian package called `bat`) - checking for
# `bat` here would never be true on Ubuntu.
if command -v batcat &>/dev/null; then
  alias cat='batcat --paging=never'
fi

# Same Debian/Ubuntu package-name-collision situation as bat/batcat above:
# apt's `fd-find` package installs its binary as `fdfind`.
if command -v fdfind &>/dev/null; then
  alias fd='fdfind'
fi

if command -v fzf &>/dev/null && command -v batcat &>/dev/null; then
  alias ff="fzf --preview 'batcat --style=numbers --color=always {}'"
fi

if command -v zoxide &>/dev/null; then
  # _ZO_DOCTOR=0 suppresses zoxide's own "possible configuration issue"
  # self-check, which false-positives whenever starship also runs (as it
  # does, later in this file - see the starship section below for why it
  # has to be last). zoxide's hook keeps working either way: starship's
  # init clobbers PROMPT_COMMAND down to the literal string
  # "starship_precmd", but only after stashing whatever was already in
  # there (zoxide's "__zoxide_hook;") into STARSHIP_PROMPT_COMMAND, which
  # starship_precmd still `eval`s every prompt. zoxide's doctor check,
  # though, just does a literal substring search for '__zoxide_hook' in
  # $PROMPT_COMMAND, which no longer finds it once starship's rewritten
  # that variable - a false positive on an already-working hook, not a
  # real misconfiguration. Confirmed reproducible with the real zoxide
  # 0.9.8 + starship binaries: `bash -i -c 'cd /tmp'` prints the warning
  # with this set to 1 (zoxide's own default) and stays silent with it
  # set to 0. The hook installation itself is a separate, unconditional
  # code path in zoxide's init script - not gated by _ZO_DOCTOR at all -
  # so suppressing the doctor's warning here can't disable the hook it's
  # complaining about. This must be exported (not just set as a one-off
  # prefix on the init call below) because the check runs later, inside
  # the `z`/`zi` wrapper functions each time `cd` is invoked - not at
  # init-script-generation time. See zoxide's own init output for the
  # check itself and its documented opt-out.
  export _ZO_DOCTOR=0
  eval "$(zoxide init bash)"
  alias cd='z'
fi

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

if command -v fzf &>/dev/null; then
  # shellcheck disable=SC1091
  source /usr/share/doc/fzf/examples/key-bindings.bash 2>/dev/null || true
  # fzf's own completion triggers (e.g. `**<Tab>`), separate from the
  # key-bindings file above - not present on every Ubuntu/fzf version, so
  # guarded the same defensive way.
  # shellcheck disable=SC1091
  source /usr/share/bash-completion/completions/fzf 2>/dev/null || true
fi

# System-wide tab completion (git, docker, apt, and many other commands) -
# apt-installed explicitly (see apps-terminal.sh), but sourcing it here is
# what actually activates it for interactive shells.
# shellcheck disable=SC1091
source /usr/share/bash-completion/bash_completion 2>/dev/null || true

if command -v git &>/dev/null; then
  alias g='git'
  alias gcm='git commit -m'
  alias gcam='git commit -a -m'
  alias gcad='git commit -a --amend'
fi

if command -v docker &>/dev/null; then
  alias d='docker'
fi

if command -v lazygit &>/dev/null; then
  alias lzg='lazygit'
fi

if command -v nvim &>/dev/null; then
  n() { if [ "$#" -eq 0 ]; then nvim .; else nvim "$@"; fi; }
fi

# Must come before the lazydocker/mise/rails checks below: those tools
# (like nvim above) aren't on PATH until this runs, so checking for them
# first would always fail and silently skip - confirmed as a real bug on
# an actual WSL2 run for mise (`mise --version` worked from a later shell
# only because this export ran unconditionally, but `mise activate` never
# fired, so `go`/`ruby`/`gem` were never actually reachable).
if [ -d "$HOME/.local/bin" ]; then
  export PATH="$HOME/.local/bin:$PATH"
fi

# lazydocker has no apt package - it installs to $HOME/.local/bin, only
# reachable after the PATH export above.
if command -v lazydocker &>/dev/null; then
  alias lzd='lazydocker'
fi

# Opt-in only (docs/superpowers/specs/2026-08-09-copilot-autopilot-mode-design.md)
# - auto-approving every tool/path/URL Copilot CLI touches is a
# safety-relevant default, not a convenience one, so this alias only exists
# when the user explicitly chose it during install or `omawsl install`.
# Like lazydocker above, `copilot` has no apt package - it installs to
# $HOME/.local/bin, only reachable after the PATH export above. Must not
# move back above that export - confirmed as a real bug, same class as the
# mise ordering issue documented above. `command -v copilot` gates the
# choices.env read (same order every other tool-conditional block in this
# file uses), so the common case - copilot not installed - skips the
# subshell fork + file read entirely instead of paying for it every shell.
if command -v copilot &>/dev/null; then
  OMAWSL_COPILOT_AUTOPILOT="$(grep -m1 '^OMAWSL_COPILOT_AUTOPILOT=' "${OMAWSL_STATE_DIR:-$HOME/.local/state/omawsl}/choices.env" 2>/dev/null | cut -d'"' -f2)"
  if [[ "$OMAWSL_COPILOT_AUTOPILOT" == "Yes"* ]]; then
    alias copilot="copilot --autopilot --allow-all"
  fi
  unset OMAWSL_COPILOT_AUTOPILOT
fi

if command -v mise &>/dev/null; then
  eval "$(mise activate bash)"
fi

# rails isn't installed via apt - it's `gem install`'d under mise's
# managed Ruby, so its binary only becomes reachable once mise's shims are
# on PATH via the activation above, not any earlier.
if command -v rails &>/dev/null; then
  alias r='rails'
fi

# opencode's installer places its binary here, not $HOME/.local/bin like
# mise/lazydocker/claude - needs its own PATH entry.
if [ -d "$HOME/.opencode/bin" ]; then
  export PATH="$HOME/.opencode/bin:$PATH"
fi

# Omakub parity: every new interactive shell drops straight into zellij -
# upstream does this via Alacritty's own `[shell] program = "zellij"`
# config; omawsl has no Alacritty equivalent (Windows Terminal's WSL
# profile is dynamically generated per machine with its own GUID, too
# fragile to target directly), so the same effect is achieved here
# instead - terminal-emulator-agnostic, works the same in Windows
# Terminal, VS Code's integrated terminal, or over SSH. Guarded on $ZELLIJ
# (which zellij itself sets in any shell it spawns) so opening a new
# pane/tab INSIDE an existing session doesn't try to exec another zellij -
# the same guard zellij's own docs recommend. Computed here (rather than
# inline at the exec site below) so the starship section right after can
# skip its own subprocess spawn in this same condition - this outer
# shell's prompt is discarded the instant exec replaces it, so evaluating
# `starship init` for it would be a wasted fork.
_omawsl_will_exec_zellij=0
if [[ -z "${ZELLIJ:-}" ]] && command -v zellij &>/dev/null; then
  _omawsl_will_exec_zellij=1
fi

# Starship (design spec docs/superpowers/specs/2026-08-09-starship-default-prompt-design.md):
# starship's own README says to add its init line at the END of .bashrc,
# after any other tool that also hooks PROMPT_COMMAND (zoxide/mise above) -
# starship/starship#6093 documents hooks registered after starship's own
# breaking the chain. Placed last (but still before the zellij exec guard
# below, which replaces this shell process outright) so starship's
# language-version modules read the already-updated PATH/env from those
# tools' own hooks, not a stale value from before they ran.
OMAWSL_FONT_MODE="$(grep -m1 '^OMAWSL_FONT_MODE=' "${OMAWSL_STATE_DIR:-$HOME/.local/state/omawsl}/choices.env" 2>/dev/null | cut -d'"' -f2)"
_omawsl_cascadia_mono=0
[[ "$OMAWSL_FONT_MODE" == "Cascadia Mono"* ]] && _omawsl_cascadia_mono=1
if command -v starship &>/dev/null; then
  # Set on every source, both branches - otherwise a font-mode switch
  # (re-sourcing this file, or a fresh pane inheriting the outer shell's
  # exported env across the exec below) would leave a stale value from
  # whichever mode was active last time this ran instead of tracking the
  # current choices.env.
  if [[ "$_omawsl_cascadia_mono" -eq 1 ]]; then
    export STARSHIP_CONFIG="$HOME/.config/starship-plain.toml"
  else
    unset STARSHIP_CONFIG
  fi
  if [[ "$_omawsl_will_exec_zellij" -eq 0 ]]; then
    eval "$(starship init bash)"
  fi
else
  # Pre-starship fallback - offline/failed install, or a checkout that
  # predates this feature and hasn't finished migrating yet (Task 6).
  # Exact byte-for-byte copy of the old static PS1 logic this replaces.
  if [[ "$_omawsl_cascadia_mono" -eq 1 ]]; then
    PS1='\u@\h:\w\$ '
  else
    PS1=$' '
  fi
  PS1="\[\e]0;\w\a\]$PS1"
fi
unset OMAWSL_FONT_MODE _omawsl_cascadia_mono

# Must be the very last thing in this file: `exec` replaces the current
# shell process, so nothing after this line would ever run.
if [[ "$_omawsl_will_exec_zellij" -eq 1 ]]; then
  # WSL2/WSLg's $XDG_RUNTIME_DIR (/mnt/wslg/runtime-dir) is a synthetic
  # mount hardcoded to UID 1000 that doesn't reliably support the chmod
  # 0700 zellij needs on its own socket dir (microsoft/WSL#9689, #10896,
  # #11542) - zellij panics with a raw "Permission denied" instead of
  # degrading gracefully (zellij-org/zellij#4155). Point it at the same
  # /tmp-based directory zellij already falls back to when
  # XDG_RUNTIME_DIR is unset, sidestepping the broken mount entirely.
  export ZELLIJ_SOCKET_DIR="/tmp/zellij-$(id -u)"
  unset _omawsl_will_exec_zellij
  exec zellij
fi
unset _omawsl_will_exec_zellij
